-- Q.1. List the month-wise average supply of parts supplied for all parts. Provide the information only if the average is higher than 250.

select month(dos) as supp_month ,
	   avg(qtysupplied) as supp_qty
from supldetl group by supp_month having supp_qty > 250;

-- Q.2. List the names of the Suppliers who do not supply part with PID ‘1’.

select * from partmaster;
select * from supldetl;
select * from suppliermaster;

select distinct name from suppliermaster where sid not in (
select sid from supldetl where pid = '1');

-- Q.3. List the part id, name, price and difference between price and average price of all parts.

select pid,name,price,(price - (select round(avg(price),0) from partmaster)) from partmaster group by  pid,name,price;

select avg(price) from partmaster;

-- Q.4. List the names of the suppliers who have supplied at least Two parts where the quantity supplied is lower than 500.

select s.name , count(p.name) as cnt  from
partmaster p join supldetl sd 
on (p.pid = sd.PID) join suppliermaster s
on (sd.sid = s.SID) 
where sd.QTYSUPPLIED < 500 group by s.name having count(p.name) >= 2 ;


-- Q.5. List the names of the suppliers who live in a city where no supply has been made. -- it means supplier iD should matched in both table but city should not be matched.

select * from partmaster;
select * from supldetl;
select * from suppliermaster;

select distinct name , s.city from 
suppliermaster s join supldetl sd 
on s.sid = sd.sid 
where s.city != sd.city order by name;

-- Q.6. List the names of the parts which have not been supplied in the month of May 2019.

select distinct p.name from
partmaster p join supldetl s
on p.pid = s.pid 
where month(dos) != 5 and year(dos) != 2019;

-- Q.7. List name and Price category for all parts. Price category has to be displayed as “Cheap”
--  -- if price is less than 200, “Medium” if the price is greater than or equal to 200 and less than 500, -- and “Costly” if the price is greater than or equal to 500.

select name,price ,
case
	when price < 200 then "Cheap"
    when  500 <= price >= 200 then "Medium"
    else "Costly"
    end as price_category
from partmaster;

-- Q.8. List the names of the suppliers who have supplied exactly 100 units of part P16.

select name from suppliermaster where sid in (
select sid from supldetl where QTYSUPPLIED = 100  and pid = 16
);

-- Q.9. List the names of the parts whose price is more than the average price of parts.

with cte as (
select avg(price) as avg_price from partmaster
)
select name,price,avg_price from 
cte c left join partmaster p 
on p.price > c.avg_price;

-- Q.10. For all products supplied by Supplier S70, List the part name and total quantity SUPPLIED.

select distinct name,qtysupplied from 
partmaster p join supldetl s
on p.pid = s.pid
where sid = 70;

